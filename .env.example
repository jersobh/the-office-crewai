# Copy to .env. Never commit .env, data/, or secrets/*.json.

# Gemini is the default provider for desks, board recall, covers, and voice.
# Leave it empty when every desk runs on another provider (see below).
GEMINI_API_KEY=

# Listen on localhost. python backend/main.py uses this directly.
# Docker publishes 127.0.0.1 only; the process inside the container uses 0.0.0.0.
OFFICE_HOST=127.0.0.1
OFFICE_PORT=8780
APP_URL=http://127.0.0.1:8780

# true  = view-only (default). Visitors can watch, not assign work.
# false = interactive. Localhost may talk to a desk, and POST tasks, notes, and archives.
OFFICE_READ_ONLY=true

# Desk model, written <provider>/<model>. A bare name means Gemini.
#   gemini/gemini-3.5-flash-lite                                  (default)
#   deepseek/deepseek-flash                                       DEEPSEEK_API_KEY
#   fireworks/accounts/fireworks/models/deepseek-v4p1-flash       FIREWORKS_API_KEY
#   openai/<model>   any OpenAI-compatible server: OFFICE_OPENAI_BASE_URL + OFFICE_OPENAI_API_KEY
# A desk can override it with `model:` in config/office.yml.
# OFFICE_TEXT_MODEL=gemini/gemini-3.5-flash-lite
# DEEPSEEK_API_KEY=
# FIREWORKS_API_KEY=
# OFFICE_OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OFFICE_OPENAI_API_KEY=

# Board recall embeddings: gemini/<model>, fireworks/<model>, openai/<model>,
# local/<sentence-transformers model> (needs pip install "epochdb[embeddings]"),
# or off. Unset: gemini-embedding-2 when GEMINI_API_KEY is set, otherwise off.
# Fireworks model ids start with fireworks/, so the value repeats it.
# Changing it needs a fresh data/.
# OFFICE_EMBED_MODEL=fireworks/fireworks/qwen3-embedding-8b
# EPOCHDB_DIM=768

# Anonymous mode: the only providers the office may call. The server refuses
# to start if a desk or the embeddings use anything else, covers and voice
# switch off unless gemini is listed, and CrewAI telemetry is disabled.
# OFFICE_ALLOWED_PROVIDERS=fireworks
# Optional: desk browsing leaves through this proxy (http://host:port or socks5://host:port).
# OFFICE_BROWSER_PROXY=

# Live voice when someone talks to a desk. Interactive mode and Gemini only.
# GEMINI_VOICE_MODEL=gemini-3.8-live

OFFICE_LANGUAGE=pt-BR
TZ=America/Sao_Paulo

# Optional. Leave empty to keep publishing disabled.
# BLOGGER_BLOG_URL=
# BLOGGER_CLIENT_ID=
# BLOGGER_CLIENT_SECRET=
# BLOGGER_TOKEN_FILE=./secrets/blogger_credentials.json

OFFICE_KICKOFF_ON_START=false
OFFICE_SCHEDULER_ENABLED=true
CREWAI_VERBOSE=true
